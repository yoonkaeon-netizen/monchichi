# ── Supabase (Project Settings > API) ──
# 비워두면 로컬 테스트용 파일 DB(.local/)를 씁니다. 배포할 때는 반드시 채워야 합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini (https://aistudio.google.com/apikey 에서 무료 발급) ──
# 비워두면 AI 검색 없이 이름이 일치하는 구획만 찾습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# IP를 그대로 저장하지 않고 이 값으로 암호화해 저장합니다. 아무 긴 문자열이나 넣으세요.
IP_HASH_SALT=change-me-to-a-long-random-string

PORT=3000
